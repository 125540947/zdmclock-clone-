node_modules
dist-ssr
.npmcache
.npmcache2
*.local
# 第三方/代理运行时目录（如 WorkBuddy 的 .hermes）：体积巨大，切勿提交
.hermes
.env
.env.generated
# 运行时数据目录整体忽略：含 db.json 以及 store.js 运行时生成的 db.json.tmp、
# db.json.corrupt-* 等备份（可能含 Cookie / 推送令牌等敏感信息），切勿入库
server/data/
server/data_demo/
server/data_test/
# web/dist 预构建产物保留入库，使克隆后 `npm start` 无需先 build 即可运行
!web/dist
# 项目级 WorkBuddy 工作记忆（含对话日志/记忆），非源码，切勿入库
.workbuddy/
# vitest/vite 加载 config 时生成的临时时间戳文件，非源码
web/vitest.config.js.timestamp-*.mjs
.DS_Store
npm-debug.log*

# 抓包导入：用户抓包文件与生成结果，不进仓库
server/captures/*.har
server/captures/*.curl.txt
server/captures/detected.json
