# 敏感 / 数据文件：切勿打进镜像
.env
.env.generated
.env.example
server/data
server/data_demo
server/data_test

# 依赖与缓存
node_modules
web/node_modules
server/node_modules
# 第三方/代理运行时目录（如 WorkBuddy 的 .hermes）：
# 体积巨大且含 node_modules，必须排除，否则 COPY . . 会把它整包打进镜像并撑爆磁盘
.hermes
.cache
coverage
dist-ssr
.npmcache
.npmcache2
*.local
npm-debug.log*

# 版本控制
.git
.gitignore

# 代理 / AI 运行时状态（含 daemon 状态、agent 内存库、日志、路径信息，M-12 禁止打进镜像）
.claude-flow
.swarm
.claude

# 本地数据 / 向量库 / 发布包（非运行时必需）
ruvector.db
*.db
releases

# 系统文件
.DS_Store
Thumbs.db
