# ===== 服务基础配置 =====
# 后端监听端口（生产/本地一致）
PORT=3000

# 运行环境：development | production
# production 时后端会托管 web/dist 静态资源，单进程即可对外服务
NODE_ENV=development

# 是否要求接口鉴权（默认关闭，保证克隆后开箱即跑）
# 设为 true 后，写操作与管理接口需要 Bearer Token（由 /api/auth/login 签发）
REQUIRE_AUTH=false

# 管理员账号（用于 /api/auth/login 签发 Token）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 签发给前端的 API Token（REQUIRE_AUTH=true 时前端需携带）
# 未设置时服务端会在每次启动时生成随机 Token（仅本地/测试用，重启后变更）。
# 生产部署请显式设置强随机值，例如：API_TOKEN=$(openssl rand -hex 24)
API_TOKEN=

# 跨域白名单（可选）。留空=仅同源（默认且最安全，生产由本服务托管前端、开发由 Vite 代理无需跨域）。
# 仅在「前端部署在独立域名」时才需要设置，例如：CORS_ORIGIN=https://app.example.com,https://www.example.com
CORS_ORIGIN=

# smzdm 适配器：mock（默认，返回仿真数据，无需真实账号）| real（真实 HTTP 调用，需配置接口）
SMZDM_ADAPTER=mock

# real 适配器对外请求超时（毫秒）。smzdm 无响应时超过该值即中止，避免请求永久挂起。
SMZDM_REQUEST_TIMEOUT=10000

# ===== REAL 适配器配置（仅当 SMZDM_ADAPTER=real 时生效）=====
# smzdm 站点基地址
SMZDM_BASE=https://www.smzdm.com
# 各接口路径（用你抓包得到的真实地址覆盖；以下为社区常见路径，可能变动）
SMZDM_API_USERINFO=/user/
SMZDM_API_CHECKIN=/user/checkin
SMZDM_API_COMMENT=/article/ajax_post_comment
SMZDM_API_FAVORITE=/article/ajax_favorite
SMZDM_API_POINT=/article/ajax_vote

# ===== 定时调度器 =====
# 调度器默认随服务启动自动开启（每 30s 轮询）。已启用且 cron 命中的任务会自动执行。
# 无需额外配置；如需关闭可在此留空（暂以代码内置开启，未来版本支持 SCHEDULER_OFF=1）。
SCHEDULER=on

# JSON 文件数据库路径（无需外部数据库，零配置）
DATA_DIR=./data

# 前端构建产物目录（生产环境由后端托管），一般无需修改
WEB_DIST=../web/dist
