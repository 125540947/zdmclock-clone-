# ⚠️ 安全须知（部署前必读）
# - 默认 REQUIRE_AUTH=true（secure-by-default）：克隆后写/管理接口需登录拿 Token 才能访问；请先设强 ADMIN_PASSWORD。
# - 仅本机临时调试可设 REQUIRE_AUTH=false（务必配合 docker-compose 的 127.0.0.1 绑定，切勿暴露公网）。
# - 公网部署：务必 REQUIRE_AUTH=true，并把 ADMIN_PASSWORD / API_TOKEN / ADMIN_TOKEN / INSTALL_TOKEN
#   全部改为强随机值（参考各变量注释的 openssl 命令）。弱口令会被启动告警。
# - Docker 部署：docker-compose.yml 已默认仅绑定 127.0.0.1（本机），需对外请自行改为 0.0.0.0 并配合鉴权 + 反代。
# - 若曾以默认配置暴露公网：关外网 → 开强鉴权 → 轮换所有已录入 Cookie 与全部 Token。

# ===== 服务基础配置 =====
# 后端监听端口（生产/本地一致，1~65535 整数；非法值回退 3000）
PORT=3000

# 后端监听地址（H-01）：默认 0.0.0.0（本机/局域网均可访问）。
# 标准 TLS 部署（nginx 反代）建议设为 127.0.0.1，关闭后端端口的外部可达性，仅经 TLS 反代进出。
BIND_ADDRESS=0.0.0.0

# 运行环境：development | production
# production 时后端会托管 web/dist 静态资源，单进程即可对外服务
NODE_ENV=development

# 是否要求接口鉴权（默认开启，secure-by-default）
# 设为 false 可退回匿名开放（仅建议本机 / 可信局域网临时调试，务必配合 BIND_ADDRESS=127.0.0.1 绑定，勿暴露公网）
# 设为 true 后，写操作与管理接口需要 Bearer Token（由 /api/auth/login 签发）
# 克隆后首次运行：请先设强 ADMIN_PASSWORD，访问 /api/auth/login 拿 Token 再调用写接口。
REQUIRE_AUTH=true

# 管理员账号（用于 /api/auth/login 签发 Token）
ADMIN_USERNAME=admin
# ⚠️ 安全：必须改为强随机密码（如 `openssl rand -hex 16`）。admin123 等弱口令会在启动时告警。
#   仅在 REQUIRE_AUTH=true（默认）时此密码才生效；改为 false 等同无防护，切勿公网暴露。
ADMIN_PASSWORD=

# 签发给前端的 API Token（REQUIRE_AUTH=true 时前端需携带）
# 未设置时服务端会在每次启动时生成随机 Token（仅本地/测试用，重启后变更）。
# 生产部署请显式设置强随机值，例如：API_TOKEN=$(openssl rand -hex 24)
API_TOKEN=

# 独立管理员 Token（H2 修复）：仅用于「系统更新」等会执行 git pull + 重启的高危接口，
# 与通用 API_TOKEN 隔离。配置后，更新接口只认 ADMIN_TOKEN（即使 API_TOKEN 泄露也无法触发更新）。
# 未设置时更新接口退回要求通用 API_TOKEN 且 REQUIRE_AUTH=true（仍不匿名放行）。
# 生产部署请显式设置强随机值，例如：ADMIN_TOKEN=$(openssl rand -hex 24)
ADMIN_TOKEN=

# 跨域白名单（可选）。留空=仅同源（默认且最安全，生产由本服务托管前端、开发由 Vite 代理无需跨域）。
# 仅在「前端部署在独立域名」时才需要设置，例如：CORS_ORIGIN=https://app.example.com,https://www.example.com
CORS_ORIGIN=

# smzdm 适配器：mock（默认，返回仿真数据，无需真实账号）| real（真实 HTTP 调用，需配置接口）
SMZDM_ADAPTER=mock

# real 适配器对外请求超时（毫秒）。smzdm 无响应时超过该值即中止，避免请求永久挂起。
SMZDM_REQUEST_TIMEOUT=10000

# ===== REAL 适配器配置（仅当 SMZDM_ADAPTER=real 时生效）=====
# smzdm 站点基地址
SMZDM_BASE=https://www.smzdm.com
# 各接口路径（用你抓包得到的真实地址覆盖；以下为社区常见路径，可能变动）
SMZDM_API_USERINFO=/user/
SMZDM_API_CHECKIN=/user/checkin
SMZDM_API_COMMENT=/article/ajax_post_comment
SMZDM_API_FAVORITE=/article/ajax_favorite
SMZDM_API_POINT=/article/ajax_vote
# 官方好价 RSS（无需 Cookie，可由服务器定时读取）。默认源当前仅 HTTP 可用；可覆盖为自有 HTTPS 代理。
SMZDM_BAOLIAO_RSS_URL=http://feed.smzdm.com/

# ===== GPT 自动回复（可选，OpenAI 兼容）=====
# 未设置 GPT_API_KEY 时，前端 GPT 自动回复不可用（生成回复会拒绝调用，费用由服务商结算）。
GPT_API_KEY=
# 接口基地址：默认 OpenAI；可改为 DeepSeek / 通义 / 本地 Ollama 等任意 OpenAI 协议服务
GPT_API_BASE=https://api.openai.com/v1
# 模型名称
GPT_MODEL=gpt-4o-mini

# ===== 推送通知（可选）=====
# 渠道 channel：none（关闭）| serverchan（Server酱 Turbo）| bark（iOS）| telegram | webhook（自定义）
# 仅在「希望用环境变量而非前端 UI 配置推送」时设置；不设置则可在前端「推送通知」页配置并持久化。
# PUSH_CHANNEL=serverchan
# Server酱 SendKey（sct.ftqq.com 获取）；Bark 则填设备 Key；Telegram 填 Bot Token
# PUSH_TOKEN=
# Telegram 专用：目标聊天 ID（与 BotFather 创建的 Bot 配合）
# PUSH_CHAT_ID=
# webhook / bark 自建服务地址（可选，bark 默认 https://api.day.app 可不填）
# PUSH_WEBHOOK=

# ===== 定时调度器 =====
# 调度器默认随服务启动自动开启（每 30s 轮询）。已启用且 cron 命中的任务会自动执行。
# 无需额外配置；如需关闭可在此留空（暂以代码内置开启，未来版本支持 SCHEDULER_OFF=1）。
SCHEDULER=on

# Cookie 健康检测节流间隔（分钟）：real 模式下，调度器每隔该时长对所有账号探活一次，
# 失效时经推送渠道告警。仅 real 模式生效。设 0 关闭自动检测（仍可手动点「🍪 检测」）。
COOKIE_HEALTH_INTERVAL_MIN=360

# ===== 自动更新（从 Git 仓库拉取最新代码）=====
# 仅在生产环境（NODE_ENV=production）由调度器节流执行，开发态不触发。
# 定时检查更新的节流间隔（分钟），默认 1440（每天检查一次）；设 0 关闭自动检查。
UPDATE_CHECK_INTERVAL_MIN=1440
# 检查到落后时是否自动拉取 + 重建前端 + 重启；默认 false（仅推送"有更新"通知，需到「系统更新」页手动升级）。
# 设为 true 后全自动；Docker 部署请用 docker compose pull && up -d（容器内 pull 无效）。
AUTO_UPDATE_APPLY=false
# 若由 supervisor（systemd / pm2 / docker）托管本服务，设 1：更新后应用只退出、不自己 re-exec，
# 由 supervisor 负责重启（避免孤儿进程 / 双进程，崩溃也能被自动拉起）。裸 npm start 部署则保持 0。
SELF_UPDATE_NO_REEXEC=0

# ===== 风控（错峰，降低触发 smzdm 限流/风控概率）=====
# 多账号签到/执行时，自第 2 个起每个账号额外等待「固定间隔 + 随机抖动」毫秒，避免同一秒扎堆请求。
# 设为 0 可关闭错峰。
CLOCK_STAGGER_MS=800
CLOCK_STAGGER_JITTER_MS=2000

# 调度补签宽限（分钟）：个人签到时间已过、但距现在不超过该分钟数时，仍补签一次，
# 覆盖「服务宕机/休眠/刚部署」期间错过的签到。设 0 关闭补签。
CATCHUP_GRACE_MIN=180

# 动作拟人化间隔（毫秒）：评论/收藏/点赞等 www 端点无 app 签名，靠「UA 轮换 + 拟人化随机间隔」
# 降低被风控按固定指纹识别为机器的概率。count 多次动作之间在该窗口内随机等待；过大拖慢、过小无效。
SMZDM_ACTION_JITTER_MIN=800
SMZDM_ACTION_JITTER_MAX=2500

# JSON 文件数据库路径（无需外部数据库，零配置）
DATA_DIR=./data

# 前端构建产物目录（生产环境由后端托管），一般无需修改
WEB_DIST=../web/dist

# ===== 安全与网络边界（审计 L-02：补全此前缺失的配置项）=====
# ⚠️ 开放模式（OPEN_MODE）：彻底移除登录鉴权，所有接口对匿名放行。
#   仅用于受信任/隔离网络（如内网开放录入系统）；系统更新等高危操作仍受 ADMIN_TOKEN 保护。
#   默认关闭（false）；公网部署切勿开启。
OPEN_MODE=false

# 信任前置代理（TRUST_PROXY）：开启后 req.ip 依据 X-Forwarded-For 计算真实访客 IP（限流/网段隔离依赖真实 IP）。
# 仅当确有可信反代（Cloudflare/宝塔/nginx 已剥离客户端伪造的 XFF）时才设 true；
# 直连暴露保持 false（req.ip 为真实套接字对端、不可伪造）。
TRUST_PROXY=false
# 受信任代理网段（H-01）：TRUST_PROXY=true 时 Express 仅当连接来自该网段才采信 XFF。
# 留空=仅 loopback（默认，匹配标准 TLS 反代）；外部反代填其出口 CIDR；设 'false' 强制只用网络层 IP。
PROXY_TRUSTED_SUBNET=

# 前置代理已认证模式（TRUST_PROXY_AUTH）：当前置（Cloudflare Access/宝塔/nginx 密码）已完成身份验证时，
# 应用层 login 自动放行（写接口仍带 token）。仅当前置有可靠保护时开启，否则等同后台裸奔。
TRUST_PROXY_AUTH=false
# 前置注入的「已认证用户」请求头（如 Cf-Access-Authenticated-User-Email / X-Forwarded-User）；
# 配置后 login 校验该头存在才放行；留空则只要 TRUST_PROXY_AUTH=true 即放行。
PROXY_AUTH_HEADER=
# 前置代理来源 IP 白名单（逗号分隔，支持单 IP 或 CIDR）；login 代理分支仅命中白名单才签发 Token。
# 强烈建议与私有绑定同时配置，避免直连暴露时攻击者自带头绕过。
PROXY_TRUSTED_IPS=

# 公开服务基址（H-04）：油猴安装脚本的「回传地址」改用此值，而非信任不可靠的 Host 头（防 Host 注入窃取 Cookie）。
# 生产部署请显式设置（如 https://your.domain）。
PUBLIC_BASE_URL=
# Host 头白名单（H-02 纵深）：逗号分隔允许 hostname；仅当未设 PUBLIC_BASE_URL 时生效，校验 req.headers.host 是否可信。
# 留空=不校验（开发态；生产务必配合 PUBLIC_BASE_URL）。
HOST_ALLOWLIST=

# 窄权限安装令牌（INSTALL_TOKEN）：油猴脚本自动推送用，避免把全权限 API_TOKEN 写进可分发脚本。
# 未设置则脚本无法自动推送；OPEN_MODE 下 /users/import 本就匿名可调用，可不设。
INSTALL_TOKEN=

# ===== 时区与签到调度时间 =====
# 时区（ZDM_TZ）：调度「今天/当前分钟」以此判定，解决容器 UTC 导致签到时间整体偏移。
# 默认 'local' 沿用进程本地时区；生产部署请设 Asia/Shanghai。
ZDM_TZ=local
DEFAULT_CHECKIN_TIME=09:00
AUTO_WINDOW_START=08:00
AUTO_WINDOW_END=10:59
CLOCK_TASK_CRON=* * * * *

# 智能启动调度宽限（分钟）：账号启动时间已过、距现在不超过该分钟数仍补跑一次；超过则跳过今天。设 0 关闭。
STARTUP_GRACE_MIN=180

# 签到失败重试（指数退避）
CLOCK_RETRY=2
CLOCK_RETRY_BASE_MS=2000

# ===== Cookie 健康检测并发（M-06）=====
# 每轮检测对每账号发起一次外部请求，固定并发上限分批执行，防止同时建立大量对外 socket。设 0/负数钳回 1。
HEALTH_CONCURRENCY=10

# ===== 风控（反检测/反封号，保守默认开启）=====
RISK_ENABLED=true
RISK_PRE_DELAY_MIN_MS=200
RISK_PRE_DELAY_MAX_MS=1500
RISK_CIRCUIT_FAILURES=5
RISK_CIRCUIT_COOLDOWN_MIN=30
RISK_ADAPTIVE_STEP_MS=2000
RISK_MAX_EXTRA_MS=60000

# 互动（评论/点赞/收藏）拟人化随机延迟（毫秒）与偶发长思考停顿
ENGAGEMENT_DELAY_MIN_MS=2000
ENGAGEMENT_DELAY_MAX_MS=15000
ENGAGEMENT_DELAY_LONG_PROB=0.15
ENGAGEMENT_DELAY_LONG_MAX_MS=30000
ENGAGEMENT_SAMPLE_MIN=3
ENGAGEMENT_SAMPLE_MAX=12

# ===== 容量与截断上限（P1-4 / P2-8，防止 db.json 无限膨胀或被恶意撑爆）=====
CLOCK_RECORDS_MAX_PER_USER=365
MAX_USERS=500
MAX_BAOLIAO_ITEMS=500
MAX_NOTE_LEN=500
MAX_PAGE_SIZE=200
COUNT_MAX=5
GPT_BATCH_MAX=10
